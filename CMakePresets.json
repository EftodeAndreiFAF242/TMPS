{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Ninja, Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "strict",
            "displayName": "Ninja, Release, warnings as errors",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-strict",
            "cacheVariables": {
                "CIVICDESK_WARNINGS_AS_ERRORS": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "default", "configurePreset": "default" },
        { "name": "strict", "configurePreset": "strict" }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "strict",
            "configurePreset": "strict",
            "output": { "outputOnFailure": true }
        }
    ]
}
